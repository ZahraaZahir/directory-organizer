generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FileStatus {
  SUCCESS
  FAILED
  PENDING
}

model FileLog {
  id            Int        @id @default(autoincrement())
  originalName  String
  originalPath  String
  movedToPath   String
  fileExtension String
  errorMessage  String?
  fileSize      Int
  processedAt   DateTime   @default(now())
  status        FileStatus
}
